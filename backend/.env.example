# 环境变量配置文件示例
# 复制此文件为 .env 并填写实际值

# 应用配置
DEBUG=true

# 远程文件服务器配置
REMOTE_SERVER_HOST=172.23.40.162
REMOTE_SERVER_USER=
REMOTE_SERVER_PASSWORD=
USE_SSH=false

# Embedding服务配置
EMBEDDING_API_URL=http://172.23.40.162:8180/v1
EMBEDDING_MODEL=embedding

# 文件路径配置（如果不使用远程服务器，可以映射到本地路径）
# OCR_BASE_PATHS=/path/to/local/ocr
# REFERENCE_BASE_PATH=/path/to/local/reference
