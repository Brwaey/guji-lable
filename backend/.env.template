# 古籍标注平台配置 - 快速开始模板
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 根据你的情况修改下面的配置
# 3. 运行 python test_connection.py 测试

# ============================================================================
# 基础配置
# ============================================================================
DEBUG=true

# ============================================================================
# 文件访问方式选择（重要！）
# ============================================================================

# 方式A: 使用SSH访问远程文件（推荐）
# 如果你能在PowerShell中执行 ssh user@172.23.40.162 登录成功，使用此方式
USE_SSH=true
REMOTE_SERVER_HOST=172.23.40.162
REMOTE_SERVER_USER=你的用户名
REMOTE_SERVER_PASSWORD=你的密码

# 方式B: 使用SMB网络共享
# 如果你在Windows映射了网络驱动器（如 Z: 盘），使用此方式
# USE_SSH=false
# 然后修改 config.py 中的路径为 Windows 路径

# 方式C: 本地开发测试
# 如果文件在本地，修改 config.py 中的路径为本地路径

# ============================================================================
# Embedding服务配置
# ============================================================================

# 默认配置（如果8180端口可访问）
EMBEDDING_API_URL=http://172.23.40.162:8180/v1
EMBEDDING_MODEL=embedding

# 如果8180端口无法访问，有以下选项：
# 选项1: 检查服务是否在运行（SSH登录服务器执行 curl http://localhost:8180/v1/models）
# 选项2: 询问管理员正确的Embedding服务地址
# 选项3: 暂时使用其他Embedding服务（如OpenAI）

# 使用OpenAI的配置示例：
# EMBEDDING_API_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-ada-002
# 需要添加: OPENAI_API_KEY=sk-...

# ============================================================================
# 文件路径配置（通常不需要修改）
# ============================================================================

# 这些是Linux服务器上的路径
# 如果 USE_SSH=true，这些路径会通过SSH访问
# 如果 USE_SSH=false，需要在Windows上映射这些路径

# OCR_BASE_PATHS=/home/maxuejiao/guji/mineru_ocr/二十四史附清史稿_ocr
# REFERENCE_BASE_PATH=/home/maxuejiao/guji/shidianguji

# ============================================================================
# 标注保存路径
# ============================================================================

# 标注结果保存位置
# Windows上使用相对路径或绝对路径
ANNOTATION_OUTPUT_PATH=./annotations

# ============================================================================
# 高级配置（通常不需要修改）
# ============================================================================

EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=60
CHUNK_SIZE=350
CHUNK_OVERLAP=50